<Project>
  <Import Project="$(AtomBuildDirectory)/PackageVersions.props" />

  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />

    <!-- Microsoft ASP.NET dependencies -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer" Version="5.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />

    <!-- Serilog assemblies loaded reflectively by the Serilog configuration reader (see the "Using"
         section in appsettings.json). The app must reference them itself to get them into the
         output and deps.json when Atom comes from a local checkout. Versions are kept in sync
         with the Atom repository. -->
    <PackageVersion Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Test coverage -->
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />

    <!-- Atom Framework -->
    <PackageVersion Include="Genius.Atom.Data" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Data.Ef" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Data.Ef.TestingUtil" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Data.Generators" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Infrastructure" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Infrastructure.TestingUtil" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Web" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Web.Telemetry" Version="$(AtomPackageVersion)" />
  </ItemGroup>
</Project>
