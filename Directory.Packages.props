<Project>
  <Import Project="$(AtomBuildDirectory)/PackageVersions.props" />

  <ItemGroup>
    <!-- Microsoft dependencies not covered by Atom's PackageVersions.props -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(FrameworkPackageVersion)" />

    <!-- Serilog assemblies loaded reflectively by the Serilog configuration reader (see the "Using"
         section in appsettings.json). The app must reference them itself to get them into the
         output and deps.json. Versions are kept in sync with the Atom repository. -->
    <PackageVersion Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- WPF/UI related dependencies -->
    <PackageVersion Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageVersion Include="Humanizer.Core" Version="2.14.1" />

    <!-- Atom Framework -->
    <PackageVersion Include="Genius.Atom.Data" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Data.Generators" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Infrastructure" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.Infrastructure.TestingUtil" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.UI.Forms" Version="$(AtomPackageVersion)" />
    <PackageVersion Include="Genius.Atom.UI.Forms.TestingUtil" Version="$(AtomPackageVersion)" />
  </ItemGroup>
</Project>
