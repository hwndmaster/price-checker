{
    "files.exclude": {
        "**/bin/": true,
        "**/obj/": true,
        "PriceChecker.Web/build/": true,
        "PriceChecker.Web/node_modules/": true,
        "**/*.lscache": true,
        "**/*.tsbuildinfo": true,
        "**/.eslintcache": true
    },
    "coverage-gutters.coverageFileNames": [
        "**/coverage/coverage.info",
        "**/coverage/lcov.info"
    ],
    "editor.tabSize": 4,
    "cSpell.customDictionaries": {
        "project-words": {
            "name": "project-words",
            "path": "${workspaceRoot}/.vscode/project-words.txt",
            "addWords": true
        }
    }
}
