{
    "version": "0.2.0",
    "configurations": [
        {
            // The Vite dev server on 5081, talking to the API on 5080 (VITE_API_URL in the web project's .env).
            "name": "Launch Web",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm start",
            "cwd": "${workspaceFolder}/PriceChecker.Web"
        },
        {
            "name": "Launch WebAPI (no build)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/PriceChecker.WebApi/bin/Debug/net10.0/PriceChecker.WebApi.exe",
            "args": [],
            "cwd": "${workspaceFolder}/PriceChecker.WebApi",
            "launchSettingsFilePath": "${workspaceFolder}/PriceChecker.WebApi/Properties/launchSettings.json",
            "launchSettingsProfile": "http",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Launch WebAPI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PriceChecker.WebApi/bin/Debug/net10.0/PriceChecker.WebApi.exe",
            "args": [],
            "cwd": "${workspaceFolder}/PriceChecker.WebApi",
            "launchSettingsFilePath": "${workspaceFolder}/PriceChecker.WebApi/Properties/launchSettings.json",
            "launchSettingsProfile": "http",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ],
    "compounds": [
        {
            // The API and the dev server together. Pick it once in the Run and Debug dropdown and F5 keeps
            // starting both; stopping one stops the other.
            "name": "API + Web",
            "configurations": ["Launch WebAPI", "Launch Web"],
            "stopAll": true
        }
    ]
}
