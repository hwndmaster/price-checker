{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build dotnet",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "PriceChecker.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build web",
            "command": "pnpm",
            "type": "shell",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/PriceChecker.Web"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        },
        {
            "label": "analyze web bundle",
            "command": "pnpm",
            "type": "shell",
            "args": [
                "exec",
                "vite",
                "build",
                "--mode",
                "production",
                "--sourcemap"
            ],
            "options": {
                "cwd": "${workspaceFolder}/PriceChecker.Web",
                "env": {
                    "BUNDLE_ANALYZE": "true"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "test dotnet coverage",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "PriceChecker.slnx",
                "/property:CollectCoverage=true",
                "/property:CoverletOutputFormat=lcov",
                "/property:CoverletOutput=./coverage/",
                "/property:IncludeTestAssembly=false",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test web coverage",
            "command": "pnpm",
            "type": "shell",
            "args": [
                "exec",
                "vitest",
                "run",
                "--silent=false",
                "--coverage"
            ],
            "options": {
                "cwd": "${workspaceFolder}/PriceChecker.Web"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        },
        {
            "label": "test coverage",
            "dependsOn": [
                "test dotnet coverage",
                "test web coverage"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "ef migration add",
            "command": "dotnet",
            "type": "process",
            "args": [
                "ef",
                "migrations",
                "add",
                "${input:migrationName}",
                "--project",
                "PriceChecker.Db",
                "--startup-project",
                "PriceChecker.Db"
            ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "dependsOn": [
                "build dotnet"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "migrationName",
            "type": "promptString",
            "description": "EF migration name, in PascalCase (e.g. AddProductNotes)"
        }
    ]
}
