{
  "$schema": "../app-host/app.schema.json",
  "name": "price-checker",
  "displayName": "PriceChecker",
  "type": "atom-webapp",
  "registry": "${PRICE_CHECKER_REGISTRY:-ghcr.io/hwndmaster}",
  "imageTag": "${PRICE_CHECKER_IMAGE_TAG:-latest}",
  "api": {
    "containerPort": 8031,
    "hostPort": "${PRICE_CHECKER_API_PORT:-5080}",
    "memory": "${PRICE_CHECKER_API_MEMORY_LIMIT:-384m}",
    "volumes": [
      { "host": "${PRICE_CHECKER_DATA_PATH}", "container": "/app/Data" },
      { "host": "${PRICE_CHECKER_LOGS_PATH}", "container": "/app/Logs" }
    ],
    "environment": {
      "Telegram__BotToken": "${PRICE_CHECKER_TELEGRAM_BOT_TOKEN:-}",
      "Telegram__ChatId": "${PRICE_CHECKER_TELEGRAM_CHAT_ID:-}"
    }
  },
  "web": {
    "containerPort": 8032,
    "hostPort": "${PRICE_CHECKER_WEB_PORT:-5081}",
    "memory": "${PRICE_CHECKER_WEB_MEMORY_LIMIT:-64m}"
  }
}
