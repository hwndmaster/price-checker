# Copy to Deployment/.env and fill in, then: docker compose --env-file .env up -d
# (Deployment/.env is gitignored by the root .gitignore's ".env" rule.)

# ── Required ──────────────────────────────────────────────────────────────────────────────────
# Paths on the DOCKER HOST for the SQLite database and the API's log files.
#
# These are handed to the host's Docker daemon when it creates the api container, so they are resolved
# against the HOST filesystem — not against anything inside the app host container. On Docker Desktop
# for Windows use a forward-slash Windows path; on a Linux host use an absolute Linux path.
PRICECHECKER_DATA_PATH=C:/PriceChecker/Data
PRICECHECKER_LOGS_PATH=C:/PriceChecker/Logs

# ── Optional ──────────────────────────────────────────────────────────────────────────────────
# Image coordinates. Images are pulled from the HOST (docker compose --profile pull pull), so it is your
# own docker login that is used:  echo <ghp_token> | docker login ghcr.io -u hwndmaster --password-stdin
#PRICECHECKER_REGISTRY=ghcr.io/hwndmaster
#PRICECHECKER_IMAGE_TAG=latest

# Leave at Missing. Always makes the app host pull for itself, and it cannot: it runs the docker CLI
# inside a container, where your registry login does not exist, so pulls come out anonymous and a
# private registry answers "error from registry: unauthorized".
#PRICECHECKER_IMAGE_PULL_POLICY=Missing

# Address the reachable port publish binds to. 127.0.0.1 makes the app local-only.
#PRICECHECKER_BIND_ADDRESS=0.0.0.0

# Host ports for the API and the SPA.
#PRICECHECKER_API_PORT=5080
#PRICECHECKER_WEB_PORT=5081

# Dashboard authentication. Left unset, the dashboard demands a login token which is printed in the app
# host's own logs:  docker logs pricechecker-apphost
# Setting this to true removes that check, exposing every log line, trace and environment variable in
# the dashboard to anyone who can reach port 15180. Only for a trusted network.
#PRICECHECKER_DASHBOARD_ANONYMOUS=false
