# Copy to .env next to app.json and fill in. Server-specific, so never committed (the root .gitignore's
# ".env" rule covers it).
#
# Read twice: by the app host, for the ${NAME} values in app.json, and by update.ps1, to pull the same
# image tag the app host will run.

# ── Required ──────────────────────────────────────────────────────────────────────────────────────
# Paths on the server for the SQLite database and the API's log files, by default inside this folder
# (C:\Docker\PriceChecker). The server's Docker daemon resolves them, so on Docker Desktop for Windows use
# a forward-slash Windows path; on Linux an absolute path.
PRICECHECKER_DATA_PATH=C:/Docker/PriceChecker/Data
PRICECHECKER_LOGS_PATH=C:/Docker/PriceChecker/Logs

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────
# Image coordinates. update.ps1 pulls with this server's own registry login:
#   echo <token with read:packages> | docker login ghcr.io -u hwndmaster --password-stdin
#PRICECHECKER_REGISTRY=ghcr.io/hwndmaster
#PRICECHECKER_IMAGE_TAG=latest

# Telegram bot for the daily scan's price alerts: the token from @BotFather and the chat the bot posts
# to. Leave either unset to keep the alerts off (see "Telegram notifications" in the repo-root README.md).
#PRICECHECKER_TELEGRAM_BOT_TOKEN=
#PRICECHECKER_TELEGRAM_CHAT_ID=

# Host ports for the API and the SPA.
#PRICECHECKER_API_PORT=5080
#PRICECHECKER_WEB_PORT=5081

# Memory limits, in docker's notation (384m, 1g). Raise one if its container keeps restarting and
# `docker inspect` reports it OOMKilled. A change applies on the next .\update.ps1 -SkipPull.
#PRICECHECKER_API_MEMORY_LIMIT=384m
#PRICECHECKER_WEB_MEMORY_LIMIT=64m
