<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0" assemblyQualifiedName="Microsoft.VisualStudio.Coverage.DynamicCoverageDataCollector, Microsoft.VisualStudio.TraceCollector, Version=11.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
        <Configuration>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <CodeCoverage>
            <ModulePaths>
              <Exclude>
                <ModulePath>.*\\PriceChecker\.Core\.Tests\.dll$</ModulePath>
                <ModulePath>.*\\PriceChecker\.Db\.Tests\.dll$</ModulePath>
                <ModulePath>.*\\PriceChecker\.WebApi\.Tests\.dll$</ModulePath>
                <ModulePath>.*\\PriceChecker\.WebApi\.IntegrationTests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*\\PriceChecker\.Db\\Migrations\\.*</Source>
                <Source>.*\\PriceChecker\.Core\.Tests\\.*</Source>
                <Source>.*\\PriceChecker\.Db\.Tests\\.*</Source>
                <Source>.*\\PriceChecker\.WebApi\.Tests\\.*</Source>
                <Source>.*\\PriceChecker\.WebApi\.IntegrationTests\\.*</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
